  "requirementId": "b29d5d27-2fbc-4516-a096-4e6d566026b4",
  "suiteName": "[SCRUM-6] US-001 — Create Lead — Edge Cases",
  "case": {
    "id": "358211ed-514a-4cc3-88d3-16e6a2da9771",
    "title": "Create Lead with numeric-only required fields (Last Name='0', Company='1')",
    "priority": "P2",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open app home",
        "value": "/"
      },
      {
        "id": "s2",
        "action": "tap",
        "targetDescription": "Go to Leads tab",
        "screenName": "HomePage",
        "pageObjectMethod": "clickLeads"
      },
      {
        "id": "s3",
        "action": "tap",
        "targetDescription": "Click New",
        "screenName": "LeadPipelineInspectionPage",
        "pageObjectMethod": "clickNew"
      },
      {
        "id": "s4",
        "action": "fill",
        "targetDescription": "Enter Last Name '0'",
        "screenName": "LeadNewPage",
        "pageObjectMethod": "fillLastName",
        "value": "0"
      },
      {
        "id": "s5",
        "action": "fill",
        "targetDescription": "Enter Company '1'",
        "screenName": "LeadNewPage",
        "pageObjectMethod": "fillCompany",
        "value": "1"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Save Lead",
        "screenName": "LeadNewPage",
        "pageObjectMethod": "clickSaveEdit"
      },
      {
        "id": "s7",
        "action": "assertVisible",
        "targetDescription": "Redirected to Lead record",
        "screenName": "LeadRecordPage",
        "pageObjectMethod": "expectRecordHeaderTitleVisible"
      },
      {
        "id": "s8",
        "action": "assertContainsText",
        "targetDescription": "Default status applied",
        "screenName": "LeadRecordPage",
        "pageObjectMethod": "expectLeadStatusContainsText",
        "assertion": "Open - Not Contacted"
      }
    ],
    "tags": [
      "@edgecase",
      "@regression"
    ]
  }
}

{
  "id": "36884e34-c95a-4a7f-bca9-b61015a8c437",
  "testPlanId": "1bd3181f-6807-410c-9916-8c6c6b4ab2c9",
  "requirementId": "6981de5b-d86a-4122-8612-3587f2774a26",
  "suiteName": "US-001 — Create Lead",
  "case": {
    "id": "36884e34-c95a-4a7f-bca9-b61015a8c437",
    "title": "Validation error when Last Name is blank",
    "priority": "P1",
    "platforms": [
      "chrome"
    ],
    "preconditions": [],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open Salesforce org base URL",
        "value": "https://orgfarm-cdb7bbd1fc-dev-ed.develop.my.salesforce.com"
      },
      {
        "id": "s2",
        "action": "tap",
        "targetDescription": "Navigate to Leads tab from Home",
        "screenName": "HomePage",
        "pageObjectMethod": "clickLeads"
      },
      {
        "id": "s3",
        "action": "tap",
        "targetDescription": "Click New to open New Lead form",
        "screenName": "LeadPipelineInspectionPage",
        "pageObjectMethod": "clickNew"
      },
      {
        "id": "s4",
        "action": "fill",
        "targetDescription": "Enter Company (mandatory) and leave Last Name blank",
        "screenName": "LeadNewPage",
        "pageObjectMethod": "fillCompany",
        "value": "ABC Technologies"
      },
      {
        "id": "s5",
        "action": "clear",
        "targetDescription": "Ensure Last Name is blank",
        "screenName": "LeadNewPage",
        "pageObjectMethod": "clearLastName"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Attempt to Save with missing Last Name",
        "screenName": "LeadNewPage",
        "pageObjectMethod": "clickSaveEdit"
      },
      {
        "id": "s7",
        "action": "assertContainsText",
        "targetDescription": "Verify error banner is shown",
        "locatorHint": "div[role='alert'], div[role='alertdialog']",
        "assertion": "Review the errors"
      },
      {
        "id": "s8",
        "action": "assertContainsText",
        "targetDescription": "Verify Last Name field shows required error",
        "locatorHint": "[aria-label='Last Name'] ~ .slds-form-element__help, [name='LastName'] ~ .slds-form-element__help",
        "assertion": "Complete this field"
      },
      {
        "id": "s9",
        "action": "assertVisible",
        "targetDescription": "Confirm still on New Lead form",
        "screenName": "LeadNewPage",
        "pageObjectMethod": "expectLastNameVisible"
      }
    ],
    "tags": [
      "@negative",
      "@regression"
    ]
  }
}
